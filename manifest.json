{
  "manifest_version": 3,
  "name": "Shopping Radar",
  "version": "2.4.0",
  "description": "Painel de inteligência de preços com leitura local dos marketplaces e sincronização com o painel online.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "action": {
    "default_title": "Abrir dashboard Shopping Radar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/shopping*",
        "https://www.google.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lista.mercadolivre.com.br/*",
        "https://www.mercadolivre.com.br/*",
        "https://*.mercadolivre.com.br/*",
        "https://www.magazineluiza.com.br/*",
        "https://shopee.com.br/*",
        "https://www.amazon.com.br/*",
        "https://*.aliexpress.com/*",
        "https://www.shopcoopera.com.br/*"
      ],
      "js": [
        "marketplace.js"
      ],
      "css": [
        "marketplace.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://lmazvxvudbhoivgvhbin.supabase.co/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*",
    "https://*.magazineluiza.com.br/*",
    "https://shopee.com.br/*",
    "https://*.amazon.com.br/*",
    "https://*.aliexpress.com/*",
    "https://*.shopcoopera.com.br/*"
  ]
}
